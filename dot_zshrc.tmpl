# ~/.zshrc — managed by chezmoi. Edit the source, not this file:
#   chezmoi edit ~/.zshrc

# --- homebrew --------------------------------------------------------------
eval "$(/opt/homebrew/bin/brew shellenv)"

# brew-installed completions must be on FPATH before oh-my-zsh runs compinit
if [ -d "$HOMEBREW_PREFIX/share/zsh-completions" ]; then
  FPATH="$HOMEBREW_PREFIX/share/zsh-completions:$FPATH"
fi

# --- oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                       # prompt is starship, initialised at the bottom
plugins=(git docker docker-compose python pip{{ if .work }} kubectl oc jira{{ end }})
source "$ZSH/oh-my-zsh.sh"

# zsh-autosuggestions from brew (the oh-my-zsh custom copy was a duplicate)
if [ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# --- runtimes --------------------------------------------------------------
# pyenv: lazy-loaded so it doesn't cost ~0.3s on every shell. The shim dir must
# be on PATH; `pyenv init -` only runs on first use.
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"
pyenv() { unset -f pyenv; eval "$(command pyenv init -)"; pyenv "$@"; }

# Node via fnm (nvm removed — it added ~1.2s to startup).
eval "$(fnm env)"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
{{ if .work }}
export PATH="$HOMEBREW_PREFIX/opt/mysql-client/bin:$PATH"
{{- end }}

# --- tools -----------------------------------------------------------------
[ -d "$HOME/.cache/lm-studio/bin" ] && export PATH="$PATH:$HOME/.cache/lm-studio/bin"
[ -x "$HOME/Developer/maestro/bin/maestro" ] && alias m="$HOME/Developer/maestro/bin/maestro"

alias cat='bat'

# SSH keys live in 1Password; use its agent.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# --- prompt ----------------------------------------------------------------
eval "$(starship init zsh)"
