# ~/.config/ghostty/config

# ── Theme ────────────────────────────────────
theme = Catppuccin Macchiato

# ── Font ────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 14
font-thicken = true

# ── Window (Omarchy: padding 14, no rounding, flat) ─────────────────────────
window-padding-x = 14
window-padding-y = 14
window-decoration = true
macos-titlebar-style = tabs
confirm-close-surface = false
resize-overlay = never
window-save-state = never

# ── Cursor (Omarchy: solid block, no blink) ─────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# ── macOS specifics Omarchy doesn't need ────────────────────────────────────
# Left Option = Alt (so tmux/nvim M- bindings work); right Option keeps
# composing accented characters, which you want on a Belgian layout.
macos-option-as-alt = left
macos-non-native-fullscreen = true

mouse-scroll-multiplier = 0.95
