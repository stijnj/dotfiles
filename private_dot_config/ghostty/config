# ~/.config/ghostty/config
# Omarchy's Ghostty config, ported to macOS, with Omarchy's default theme
# (Tokyo Night) written out as literal colours so it can't drift.

# ── Theme: Tokyo Night (Omarchy default) ────────────────────────────────────
background = 1a1b26
foreground = a9b1d6
cursor-color = 7aa2f7
selection-background = 292e42
selection-foreground = c0caf5

palette = 0=#414868
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#ad8ee6
palette = 6=#449dab
palette = 7=#a9b1d6
palette = 8=#565f89
palette = 9=#ff7a93
palette = 10=#b9f27c
palette = 11=#ff9e64
palette = 12=#7da6ff
palette = 13=#bb9af7
palette = 14=#0db9d7
palette = 15=#c0caf5

# ── Font ────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 14
font-thicken = true

# ── Window (Omarchy: padding 14, no rounding, flat) ─────────────────────────
window-padding-x = 14
window-padding-y = 14
window-decoration = true
macos-titlebar-style = tabs
confirm-close-surface = false
resize-overlay = never
window-save-state = never

# ── Cursor (Omarchy: solid block, no blink) ─────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# ── macOS specifics Omarchy doesn't need ────────────────────────────────────
# Left Option = Alt (so tmux/nvim M- bindings work); right Option keeps
# composing accented characters, which you want on a Belgian layout.
macos-option-as-alt = left
macos-non-native-fullscreen = true

# ── Keybinds (Omarchy parity) ───────────────────────────────────────────────
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard

mouse-scroll-multiplier = 0.95
