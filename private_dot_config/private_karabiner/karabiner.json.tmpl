{{- /*
  ~/.config/karabiner/karabiner.json — managed by chezmoi.

  This is a TEMPLATE. Karabiner rewrites this file whenever you change
  anything in its own UI, so `chezmoi diff` will show drift; re-adopting it
  means hand-merging the change back into the template, not `chezmoi add`.

  SUPER = Caps Lock, remapped below to cmd+ctrl+alt (NOT four-key Hyper --
  Shift is deliberately left free, because half the bindings use SUPER+SHIFT).

  The app launchers below used to live in ~/.aerospace.toml as
  `exec-and-forget`. AeroSpace is gone; they are shell_command manipulators
  now. `open` is spelled absolutely because Karabiner runs shell_command with
  a minimal environment, not your login shell's PATH.

  Window management is NOT here. Raycast owns Super + arrows / F / C / R,
  bound in its own UI -- those hotkeys are not version-controlled. Do not add
  a tiling rule back without deleting them there first, or the two layers will
  both claim the same keys.
*/ -}}
{
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "keyboard_type_v2": "iso"
            },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock → Super (⌘⌃⌥), Escape when tapped alone",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_command",
                                        "modifiers": [
                                            "left_control",
                                            "left_option"
                                        ],
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "key_code": "escape"
                                    }
                                ],
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 250
                                }
                            }
                        ]
                    },
                    {
                        "description": "Super + V — paste in terminals (Super + C belongs to Raycast: Center)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^com\\.googlecode\\.iterm2$"
                                        ]
                                    }
                                ],
                                "from": {
                                    "key_code": "v",
                                    "modifiers": {
                                        "mandatory": [
                                            "left_command",
                                            "left_control",
                                            "left_option"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "v",
                                        "modifiers": [
                                            "left_command"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Super + key — launch applications (was AeroSpace exec-and-forget)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] } },
                                "to": [ { "shell_command": "/usr/bin/open -na Ghostty" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -na \"Edge\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "b", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -na \"Edge\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "f", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a Finder" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "o", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a Obsidian" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "m", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a Spotify" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "d", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -na Ghostty --args -e lazydocker" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "g", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -na Ghostty --args -e lazygit" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "slash", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"1Password\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "a", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Claude\"" } ]
                            }{{ if .work }},
                            {
                                "type": "basic",
                                "from": { "key_code": "e", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Microsoft Outlook\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "c", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Outlook Calendar\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "w", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Confluence\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "j", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Jira\"" } ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "t", "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "shift"] } },
                                "to": [ { "shell_command": "/usr/bin/open -a \"Microsoft Teams\"" } ]
                            }{{ end }}
                        ]
                    }
                ]
            }
        }
    ]
}
