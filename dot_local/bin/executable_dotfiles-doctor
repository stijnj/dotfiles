#!/bin/bash
# dotfiles-doctor — verifies the parts of this setup that a script cannot install.
# Run after `chezmoi apply` on a new machine.

pass=0; fail=0
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=$((fail+1)); }

echo
echo "Binaries"
for b in chezmoi starship op brew git fnm pyenv; do
  command -v "$b" >/dev/null 2>&1 && ok "$b on PATH" || bad "$b missing"
done

echo
echo "Applications"
[ -d "/Applications/Karabiner-Elements.app" ] && ok "Karabiner-Elements installed" \
  || bad "Karabiner-Elements missing (brew install --cask karabiner-elements, needs sudo)"
[ -d "/Applications/Raycast.app" ] && ok "Raycast installed" || bad "Raycast missing"
[ -d "/Applications/Ghostty.app" ] && ok "Ghostty installed" || bad "Ghostty missing"

echo
echo "Karabiner driver"
if pgrep -qf 'Karabiner-VirtualHIDDevice-Daemon' 2>/dev/null; then
  ok "virtual HID daemon running"
else
  bad "virtual HID daemon not running — approve the driver extension in"
  echo "      System Settings > General > Login Items & Extensions > Driver Extensions"
fi
_kb="$HOME/.config/karabiner/karabiner.json"
if [ -f "$_kb" ] && grep -q 'Escape when tapped alone' "$_kb" 2>/dev/null; then
  ok "Caps Lock → Super rule present in karabiner.json"
else
  bad "Caps Lock → Super rule missing from karabiner.json"
fi
if [ -f "$_kb" ] && grep -q 'macOS native tiling' "$_kb" 2>/dev/null; then
  ok "tiling rule present in karabiner.json"
else
  bad "tiling rule missing from karabiner.json — run: chezmoi apply"
fi
if [ -f "$_kb" ] && grep -q 'launch applications' "$_kb" 2>/dev/null; then
  ok "app-launch rule present in karabiner.json"
else
  bad "app-launch rule missing from karabiner.json — run: chezmoi apply"
fi

echo
echo "Window manager"
# There is deliberately none: tiling is macOS native, driven through Karabiner.
# This check fails if one reappears, because a third-party WM will fight the
# native tiling shortcuts for the same keys. See docs/rejected/.
_wm=""
for _app in AeroSpace yabai Amethyst Rectangle "Rectangle Pro" Moom Magnet Loop; do
  [ -d "/Applications/$_app.app" ] && _wm="$_wm $_app"
done
for _bin in aerospace yabai; do
  command -v "$_bin" >/dev/null 2>&1 && _wm="$_wm $_bin(bin)"
done
[ -f "$HOME/.aerospace.toml" ] && _wm="$_wm ~/.aerospace.toml"
if [ -z "$_wm" ]; then
  ok "no window manager installed"
else
  bad "window manager present:$_wm — native tiling will fight it for the same keys"
fi

echo
echo "1Password"
if op account list >/dev/null 2>&1 && [ -n "$(op account list 2>/dev/null)" ]; then
  ok "op signed in"
else
  bad "op not signed in — run: eval \$(op signin)"
fi
[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ] \
  && ok "1Password SSH agent socket present" || bad "1Password SSH agent socket missing"
ssh-add -l >/dev/null 2>&1 && ok "SSH agent has keys" || bad "SSH agent has no keys"

echo
echo "Git"
git config --get user.signingkey >/dev/null 2>&1 && ok "signing key configured" || bad "no signing key"
if git config --get commit.gpgsign 2>/dev/null | grep -q true; then ok "commit signing on"; else bad "commit signing off"; fi

echo
echo "Homebrew bundle"
# --no-upgrade so a merely-outdated package is not reported as a failure;
# this checks what is MISSING, which is what actually breaks the setup.
_bf=$(mktemp)
chezmoi execute-template '{{ template "Brewfile" . }}' > "$_bf"
_missing=$(brew bundle check --no-upgrade --verbose --file="$_bf" 2>&1 | grep '^→' || true)
rm -f "$_bf"
if [ -z "$_missing" ]; then
  ok "Brewfile satisfied"
else
  bad "Brewfile has missing packages:"
  echo "$_missing" | sed 's/^/      /'
  echo "      Anything needing sudo must be installed by hand."
fi

echo
echo "macOS tiling settings"
for _k in EnableTilingByEdgeDrag EnableTopTilingByEdgeDrag EnableTilingOptionAccelerator; do
  [ "$(defaults read com.apple.WindowManager "$_k" 2>/dev/null)" = "1" ] \
    && ok "$_k on" || bad "$_k not set — run: chezmoi apply"
done
[ "$(defaults read com.apple.WindowManager EnableTiledWindowMargins 2>/dev/null)" = "0" ] \
  && ok "tiled window margins off" || bad "tiled window margins not off"
[ "$(defaults read com.apple.dock mru-spaces 2>/dev/null)" = "0" ] \
  && ok "Spaces do not rearrange (mru-spaces=false)" || bad "mru-spaces is not false"

echo
echo "Application launch targets"
# Every app the Karabiner launch rule calls must resolve, or the key does
# nothing. Read out of the live file rather than hardcoded, so this follows
# work/personal and any binding you add without needing an edit here.
_apps_tmp=$(mktemp)
if [ -f "$_kb" ]; then
  awk '
    /shell_command/ {
      l = $0
      gsub(/\\"/, "", l)
      sub(/.*\/usr\/bin\/open /, "", l)
      sub(/ --args.*/, "", l)
      sub(/"[^"]*$/, "", l)
      sub(/^-na /, "", l)
      sub(/^-a /, "", l)
      gsub(/^[ \t]+|[ \t]+$/, "", l)
      if (l != "") print l
    }
  ' "$_kb" | sort -u > "$_apps_tmp"
  # Fed by redirect, not a pipe: a `while` on the right of a pipe runs in a
  # subshell and the pass/fail counters would be lost with it.
  while IFS= read -r _app; do
    if osascript -e "id of app \"$_app\"" >/dev/null 2>&1; then
      ok "open -a \"$_app\" resolves"
    else
      bad "open -a \"$_app\" does NOT resolve — install it (webapps: Safari > Share > Add to Dock)"
    fi
  done < "$_apps_tmp"
  rm -f "$_apps_tmp"
else
  bad "karabiner.json missing — cannot check launch targets"
fi
echo
printf '  %d passed, %d failed\n\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
