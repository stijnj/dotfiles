# ~/.aerospace.toml — managed by chezmoi. Edit the source:
#   chezmoi edit ~/.aerospace.toml && aerospace reload-config
#
# Ported from omakase/aerospace.toml. Every bundle id below was verified
# with `osascript -e 'id of app "X"'` on 2026-08-26.
# Omarchy 4.0's keymap, ported to macOS.
#
# SUPER on Omarchy == Caps Lock on this machine, remapped by Karabiner to
# cmd+ctrl+alt (NOT the usual four-key Hyper -- Shift is deliberately left
# free, because Omarchy uses SUPER+SHIFT for half its bindings).
#
#   Omarchy SUPER + x         ->  cmd-ctrl-alt-x
#   Omarchy SUPER + SHIFT + x ->  cmd-ctrl-alt-shift-x
#
# Reload after editing:  aerospace reload-config

start-at-login = true

# Omarchy's dwindle-ish feel: containers flatten, nested splits alternate.
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'
accordion-padding = 30

# Don't let a hidden app quietly reappear mid-tiling.
automatically-unhide-macos-hidden-apps = false

on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

[key-mapping]
# AZERTY: change to 'dvorak'/'colemak' or define [key-mapping.key-notation-to-key-code]
# if your physical layout isn't QWERTY. Bindings below are written in QWERTY notation.
preset = 'qwerty'

# Omarchy: gaps_in = 5, gaps_out = 10
[gaps]
inner.horizontal = 10
inner.vertical   = 10
outer.left       = 10
outer.right      = 10
outer.top        = 10
outer.bottom     = 10


[mode.main.binding]

# ── Applications (Omarchy: SUPER + RETURN, SUPER + SHIFT + letter) ──────────
cmd-ctrl-alt-enter        = 'exec-and-forget open -na Ghostty'
cmd-ctrl-alt-shift-enter  = 'exec-and-forget open -na "Edge"'
cmd-ctrl-alt-shift-b      = 'exec-and-forget open -na "Edge"'
cmd-ctrl-alt-shift-f      = 'exec-and-forget open -a Finder'
cmd-ctrl-alt-shift-o      = 'exec-and-forget open -a Obsidian'
cmd-ctrl-alt-shift-m      = 'exec-and-forget open -a Spotify'
cmd-ctrl-alt-shift-d      = 'exec-and-forget open -na Ghostty --args -e lazydocker'
cmd-ctrl-alt-shift-g      = 'exec-and-forget open -na Ghostty --args -e lazygit'
cmd-ctrl-alt-shift-slash  = 'exec-and-forget open -a "1Password"'

# Omarchy's slots, your tools. Where Omarchy ships something you don't use,
# the slot keeps its meaning and changes its app:
#   A = the AI slot        (Omarchy: ChatGPT)
#   E = email, C = calendar (Omarchy: HEY)
#   W = the writing app    (Omarchy: Omawrite)
#   G = the freed Signal slot
# Install webapps as dock apps first (Safari: Share -> Add to Dock), then
# `open -a "<name>"` matches the name you gave it.
cmd-ctrl-alt-shift-a      = 'exec-and-forget open -a "Claude"'
{{ if .work -}}
cmd-ctrl-alt-shift-e      = 'exec-and-forget open -a "Microsoft Outlook"'
cmd-ctrl-alt-shift-c      = 'exec-and-forget open -a "Outlook Calendar"'
cmd-ctrl-alt-shift-w      = 'exec-and-forget open -a "Confluence"'
cmd-ctrl-alt-shift-j      = 'exec-and-forget open -a "Jira"'
cmd-ctrl-alt-shift-t      = 'exec-and-forget open -a "Microsoft Teams"'
{{- end }}

# ── Window (Omarchy: SUPER + W/F/T/J/L/O) ───────────────────────────────────
cmd-ctrl-alt-w            = 'close'
cmd-ctrl-alt-f            = 'fullscreen'
cmd-ctrl-alt-t            = 'layout floating tiling'
cmd-ctrl-alt-j            = 'layout tiles horizontal vertical'
cmd-ctrl-alt-l            = 'layout accordion tiles'
cmd-ctrl-alt-b            = 'balance-sizes'
cmd-ctrl-alt-shift-backspace = 'close-all-windows-but-current'

# ── Focus / move (Omarchy: SUPER + arrows, SUPER + SHIFT + arrows) ──────────
cmd-ctrl-alt-left         = 'focus left'
cmd-ctrl-alt-down         = 'focus down'
cmd-ctrl-alt-up           = 'focus up'
cmd-ctrl-alt-right        = 'focus right'

cmd-ctrl-alt-shift-left   = 'move left'
cmd-ctrl-alt-shift-down   = 'move down'
cmd-ctrl-alt-shift-up     = 'move up'
cmd-ctrl-alt-shift-right  = 'move right'

# ── Resize (Omarchy: SUPER + minus/equal) ───────────────────────────────────
cmd-ctrl-alt-minus        = 'resize smart -50'
cmd-ctrl-alt-equal        = 'resize smart +50'
cmd-ctrl-alt-shift-minus  = 'resize smart -200'
cmd-ctrl-alt-shift-equal  = 'resize smart +200'

# ── Workspaces (Omarchy: SUPER + 1..0, SUPER + SHIFT + 1..0, SUPER + TAB) ───
# 1 term · 2 web · 3 code · 4 jira · 5 chat · 6 notes · 7 mail · 8 scratch · 9 media
cmd-ctrl-alt-1 = 'workspace 1'
cmd-ctrl-alt-2 = 'workspace 2'
cmd-ctrl-alt-3 = 'workspace 3'
cmd-ctrl-alt-4 = 'workspace 4'
cmd-ctrl-alt-5 = 'workspace 5'
cmd-ctrl-alt-6 = 'workspace 6'
cmd-ctrl-alt-7 = 'workspace 7'
cmd-ctrl-alt-8 = 'workspace 8'
cmd-ctrl-alt-9 = 'workspace 9'
cmd-ctrl-alt-0 = 'workspace 10'

cmd-ctrl-alt-shift-1 = 'move-node-to-workspace 1  --focus-follows-window'
cmd-ctrl-alt-shift-2 = 'move-node-to-workspace 2  --focus-follows-window'
cmd-ctrl-alt-shift-3 = 'move-node-to-workspace 3  --focus-follows-window'
cmd-ctrl-alt-shift-4 = 'move-node-to-workspace 4  --focus-follows-window'
cmd-ctrl-alt-shift-5 = 'move-node-to-workspace 5  --focus-follows-window'
cmd-ctrl-alt-shift-6 = 'move-node-to-workspace 6  --focus-follows-window'
cmd-ctrl-alt-shift-7 = 'move-node-to-workspace 7  --focus-follows-window'
cmd-ctrl-alt-shift-8 = 'move-node-to-workspace 8  --focus-follows-window'
cmd-ctrl-alt-shift-9 = 'move-node-to-workspace 9  --focus-follows-window'
cmd-ctrl-alt-shift-0 = 'move-node-to-workspace 10 --focus-follows-window'

cmd-ctrl-alt-tab          = 'workspace --wrap-around next'
cmd-ctrl-alt-shift-tab    = 'workspace --wrap-around prev'
cmd-ctrl-alt-backtick     = 'workspace-back-and-forth'

# ── Monitors (Omarchy: SUPER + SHIFT + ALT + arrows) ────────────────────────
cmd-ctrl-alt-shift-leftSquareBracket  = 'move-workspace-to-monitor --wrap-around prev'
cmd-ctrl-alt-shift-rightSquareBracket = 'move-workspace-to-monitor --wrap-around next'
cmd-ctrl-alt-leftSquareBracket        = 'focus-monitor --wrap-around prev'
cmd-ctrl-alt-rightSquareBracket       = 'focus-monitor --wrap-around next'

# ── Housekeeping ────────────────────────────────────────────────────────────
cmd-ctrl-alt-shift-r      = 'reload-config'
cmd-ctrl-alt-shift-semicolon = 'flatten-workspace-tree'


# ═══ Apps that put themselves away ══════════════════════════════════════════
# The single most valuable block in this file. Find IDs with:
#   aerospace list-apps
#   osascript -e 'id of app "Slack"'

[[on-window-detected]]
if.app-id = 'com.microsoft.edgemac'
run = 'move-node-to-workspace 1'

{{ if .work -}}
[[on-window-detected]]
if.app-id = 'com.microsoft.teams2'
run = 'move-node-to-workspace 2'
{{- end }}

[[on-window-detected]]
if.app-id = 'com.mitchellh.ghostty'
run = 'move-node-to-workspace 2'

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = 'move-node-to-workspace 2'

{{ if .work -}}
[[on-window-detected]]
if.app-id = 'com.microsoft.Outlook'
run = 'move-node-to-workspace 3'
{{- end }}

[[on-window-detected]]
if.app-id = 'com.jetbrains.datagrip'
run = 'move-node-to-workspace 4'

[[on-window-detected]]
if.app-id = 'com.microsoft.VSCode'
run = 'move-node-to-workspace 4'

[[on-window-detected]]
if.app-id = 'com.anthropic.claudefordesktop'
run = 'move-node-to-workspace 5'

[[on-window-detected]]
if.app-id = 'com.spotify.client'
run = 'move-node-to-workspace 9'

# Things that must never be tiled (Omarchy floats these too).
[[on-window-detected]]
if.app-id = 'com.apple.systempreferences'
run = 'layout floating'

[[on-window-detected]]
if.app-id = 'com.1password.1password'
run = 'layout floating'

[[on-window-detected]]
if.app-id = 'com.apple.finder'
if.window-title-regex-substring = 'Info$'
run = 'layout floating'

[[on-window-detected]]
if.app-id = 'com.apple.ActivityMonitor'
run = 'layout floating'
